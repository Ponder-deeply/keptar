{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "worktree": {
    "baseRef": "head"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  },
  "permissions": {
    "additionalDirectories": ["~/Documents/Brain/Personal/Projects/Képtár"],
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm test:int)",
      "Bash(pnpm test:int *)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm test:e2e *)",
      "Bash(pnpm build)",
      "Bash(pnpm dev)",
      "Bash(pnpm generate:types)",
      "Bash(pnpm generate:importmap)",
      "Bash(pnpm install --frozen-lockfile*)",
      "Bash(pnpm exec prettier --check *)",
      "Bash(pnpm exec eslint *)",
      "Bash(bash .claude/hooks/worktree-setup.sh*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git worktree list*)",
      "Read(~/Documents/Brain/Personal/Projects/Képtár/**)",
      "mcp__next-devtools__*"
    ],
    "ask": [
      "Bash(pnpm seed*)",
      "Bash(pnpm import:instagram*)",
      "Bash(pnpm instagram:token*)",
      "Bash(pnpm tag:artists*)",
      "Bash(pnpm payload migrate*)",
      "Bash(git push*)",
      "Edit(~/Documents/Brain/**)",
      "Write(~/Documents/Brain/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/.claude/worktrees/*/.env)",
      "Edit(~/Documents/Brain/Personal/Projects/Képtár/DIMI1.md)",
      "Write(~/Documents/Brain/Personal/Projects/Képtár/DIMI1.md)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh\"",
            "timeout": 180
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-edit.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-on-stop.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-on-stop.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}

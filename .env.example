# SQLite locally; use postgres://user:pass@host:5432/keptar in production.
DATABASE_URL=file:./keptar.db
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Public base URL, read at runtime (links in emails, CSRF origin).
SERVER_URL=http://localhost:3000

# Optional. Without it, outgoing emails (magic links, inquiries) are logged to the console.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@keptar.hu

# Set it in production. Inquiries for artists without an email address (most
# imported ones) are sent here so staff can forward them (they stay delivered: false).
# Claim/remove profile requests are announced here too.
# Empty: they are only stored, and each one logs an error.
INQUIRY_FALLBACK_EMAIL=

# Seed script (pnpm seed) admin account.
SEED_ADMIN_EMAIL=admin@keptar.local
SEED_ADMIN_PASSWORD=keptar-admin

# Instagram import (pnpm import:instagram): Graph API Business Discovery, used to
# fetch followed artists' profiles and post links. Our own Instagram professional
# account's ID and a user token with instagram_basic, instagram_manage_insights
# and pages_read_engagement. `pnpm instagram:token` prints both (see
# docs/INSTAGRAM.md); META_APP_ID / META_APP_SECRET are only needed for that.
# Not needed with --handles-only.
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_VERSION=v26.0

# Tagging script (pnpm tag:artists).
ANTHROPIC_API_KEY=
